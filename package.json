{
  "name": "protoa",
  "private": true,
  "description": "Protoa: a family of learning apps. The German course (apps/deutsch) is the first.",
  "engines": { "node": ">=22.9" },
  "scripts": {
    "art": "node scripts/art.mjs",
    "setup": "npm install --prefix server",
    "dev": "npm run dev --prefix server",
    "dev:fake-ai": "npm run dev --prefix server -- --fake-ai",
    "start": "npm start --prefix server",
    "test": "npm test --prefix server",
    "smoke": "node scripts/smoke.mjs",
    "smoke:ios": "node scripts/smoke-ios.mjs",
    "icons": "node scripts/icons.mjs"
  }
}
