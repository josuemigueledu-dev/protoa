# Copy to .env and fill in. .env is git-ignored; never commit a real key.

# Claude API key from https://console.anthropic.com/ (required for the AI features)
ANTHROPIC_API_KEY=

# Model for all AI tasks (default claude-opus-5-5). PROTOA_MODEL_QUICK overrides it
# for the quick tasks only (answer checks, hints), e.g. claude-haiku-5-5 to cut cost.
# PROTOA_MODEL=claude-opus-5-5
# PROTOA_MODEL_QUICK=

# AI requests allowed per client per 10 minutes (default 60)
# AI_RATE_LIMIT=60

# Set when running behind a proxy or load balancer, so rate limits use the real client IP
# TRUST_PROXY=1

# PORT=8787

# Development only: canned AI replies, no key and no cost (same as `npm run dev:fake-ai`).
# PROTOA_FAKE_AI=1
# PROTOA_FAKE_AI_DELAY=700
# Make every practice AI call fail, to see the error states: timeout, rate_limited, refused, bad_output, upstream or unavailable
# PROTOA_FAKE_AI_FAIL=timeout
